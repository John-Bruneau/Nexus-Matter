{
  "entities": {
    "User": {
      "title": "Utilisateur",
      "description": "Profil chercheur",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["researcher", "admin"] }
      },
      "required": ["uid", "email"]
    },
    "Project": {
      "title": "Projet de Recherche",
      "description": "Un projet collaboratif",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "ownerId": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["active", "completed", "archived"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerId", "status"]
    },
    "Note": {
      "title": "Note Scientifique",
      "description": "Commentaire ou observation sur un élément",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "elementId": { "type": "integer" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "content": { "type": "string" },
        "projectId": { "type": "string" },
        "isPrivate": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["elementId", "authorId", "content"]
    },
    "Favorite": {
      "title": "Élément Favori",
      "description": "Référence rapide pour un chercheur",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "elementId": { "type": "integer" },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "elementId"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Profils des chercheurs"
    },
    "projects/{projectId}": {
      "schema": "Project",
      "description": "Dépôts de projets collaboratifs"
    },
    "notes/{noteId}": {
      "schema": "Note",
      "description": "Notes et annotations sur les éléments"
    },
    "users/{userId}/favorites/{elementId}": {
      "schema": "Favorite",
      "description": "Liste personnelle des éléments suivis"
    }
  }
}
