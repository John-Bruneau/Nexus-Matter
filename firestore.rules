rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    match /test/connection {
      allow get: if true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com'); // Simplified for preview environment but following spirit
    }

    // Helper to check membership in projects
    function isMember(projectId) {
      return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.members;
    }

    // 1. Users Collection
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'displayName', 'email', 'photoURL', 'role', 'lastLogin']) &&
               data.keys().size() == 6 &&
               data.uid == request.auth.uid &&
               data.uid is string &&
               data.displayName is string && data.displayName.size() <= 100 &&
               data.email is string && data.email.size() <= 150 &&
               data.role in ['researcher', 'admin'] &&
               data.lastLogin == request.time;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid; // Secure list queries
      allow create: if isVerified() && isValidUser(incoming());
      allow update: if isVerified() && isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLogin']);

      match /favorites/{elementId} {
        function isValidFavorite(data) {
          return data.keys().hasAll(['userId', 'elementId', 'addedAt']) &&
                 data.keys().size() == 3 &&
                 data.userId == request.auth.uid &&
                 data.elementId is int &&
                 data.addedAt == request.time;
        }
        allow read: if isOwner(userId);
        allow create, update: if isVerified() && isOwner(userId) && isValidFavorite(incoming());
        allow delete: if isOwner(userId);
      }
    }

    // 2. Projects Collection
    match /projects/{projectId} {
      function isValidProject(data) {
        return data.keys().hasAll(['name', 'description', 'ownerId', 'members', 'status', 'createdAt', 'updatedAt']) &&
               data.keys().size() == 7 &&
               data.name is string && data.name.size() <= 200 &&
               data.description is string && data.description.size() <= 2000 &&
               data.ownerId == request.auth.uid &&
               data.members is list && data.members.size() <= 50 &&
               data.status in ['active', 'completed', 'archived'] &&
               data.createdAt is timestamp &&
               data.updatedAt == request.time;
      }

      allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.members);
      allow create: if isVerified() && isValidProject(incoming()) && incoming().createdAt == request.time;
      allow update: if isVerified() && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.members) &&
                    isValidProject(incoming()) &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().ownerId == existing().ownerId;
      allow delete: if isVerified() && resource.data.ownerId == request.auth.uid;
    }

    // 3. Notes Collection
    match /notes/{noteId} {
      function isValidNote(data) {
        return data.keys().hasAll(['elementId', 'authorId', 'authorName', 'content', 'projectId', 'isPrivate', 'createdAt', 'tags']) &&
               data.keys().size() == 8 &&
               data.elementId is int &&
               data.authorId == request.auth.uid &&
               data.content is string && data.content.size() <= 5000 &&
               (data.projectId == null || (isValidId(data.projectId) && exists(/databases/$(database)/documents/projects/$(data.projectId)))) &&
               data.isPrivate is bool &&
               data.tags is list && data.tags.size() <= 20 &&
               data.createdAt is timestamp;
      }

      allow read: if isSignedIn() && (
        resource.data.isPrivate == false || 
        resource.data.authorId == request.auth.uid ||
        (resource.data.projectId != null && request.auth.uid in get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.members)
      );
      allow create: if isVerified() && isValidNote(incoming()) && 
                    incoming().createdAt == request.time &&
                    (incoming().projectId == null || request.auth.uid in get(/databases/$(database)/documents/projects/$(incoming().projectId)).data.members);
      allow update: if isVerified() && isOwner(existing().authorId) && isValidNote(incoming()) &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().authorId == existing().authorId &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['content', 'isPrivate', 'projectId', 'tags']) &&
                    (incoming().projectId == null || request.auth.uid in get(/databases/$(database)/documents/projects/$(incoming().projectId)).data.members);
      allow delete: if isVerified() && isOwner(existing().authorId);
    }
  }
}
